# Copy to .env and fill in the values. Never commit the real .env file.

# --- Server ---
GO_ENV=development
PORT=8080
APP_URL=http://localhost:8080
# Comma-separated list of origins allowed by CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_URI=postgres://evently:evently@localhost:5432/evently?sslmode=disable
# Set to false to let GORM create/update the tables on startup.
DISABLE_AUTO_MIGRATION=false

# --- JWT (the app's own access tokens) ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_ISSUER=evently-app
JWT_ACCESS_TTL=1h

# --- Google OAuth2 ---
GAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GAUTH_CLIENT_SECRET=your-client-secret
GAUTH_CLIENT_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
# Optional; this is the default.
GAUTH_USER_INFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
